{
  "model": "sonnet",
  "permissions": {
    "deny": [
      "Bash(gh pr merge *)",
      "Bash(gh api *merge*)",
      "Bash(git push origin main*)",
      "Bash(git push origin HEAD:main*)",
      "Bash(git push * main)",
      "Bash(git push --force origin main*)",
      "Bash(vercel *)"
    ]
  }
}
